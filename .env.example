# Copy this file to .env and fill in the values.
# Never commit the real .env file — it is listed in .gitignore.
# See specs/00-engineering/spec-00e-prerequisites-setup.md for setup instructions.

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a random secure string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SIGNING_KEY=change-me-to-a-random-secure-string

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/bigschool

# ── Redis (Celery broker & result backend) ────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── OAuth — Google ────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# ── OAuth — Microsoft (Azure Entra ID) ───────────────────────────────────────
MICROSOFT_OAUTH_CLIENT_ID=your-microsoft-client-id
MICROSOFT_OAUTH_CLIENT_SECRET=your-microsoft-client-secret

# ── Market data providers ─────────────────────────────────────────────────────
MARKET_DATA_TWELVE_DATA_API_KEY=your-twelve-data-api-key
MARKET_DATA_FINNHUB_API_KEY=your-finnhub-api-key

# ── AI providers (only the active provider's key is required at startup) ──────
AI_ANTHROPIC_API_KEY=your-anthropic-api-key
AI_OPENAI_API_KEY=your-openai-api-key
AI_GEMINI_API_KEY=your-gemini-api-key

# ── Application URLs ──────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
